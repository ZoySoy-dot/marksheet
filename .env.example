# Neon Postgres connection string.
# Neon dashboard → your project → Connection Details → copy the pooled connection string.
# On Vercel this is set for you by the Neon integration: vercel env pull .env.local
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Clerk keys. Clerk dashboard → your application → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
